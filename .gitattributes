# Preserve exact snapshot bytes; reuse repository Git LFS rules for binary resources.
# Keep source, scenes, prefabs and .meta files diffable in normal Git.
* -text
*.cs diff
*.shader diff
*.hlsl diff
*.json diff
*.md diff
*.meta diff
*.unity diff
*.prefab diff
# Binary artwork/audio/models use Git LFS; Desktop supports the same pointers.
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
