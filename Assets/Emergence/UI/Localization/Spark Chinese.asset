    - key: SparkIntroTitle1
      value: "<size=18><color=#82AAB9>01 / 03</color></size>\n\u4E00\u6B21\u523A\u6FC0\uFF0C\u5168\u8111\u56DE\u54CD"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SparkIntroDescription1
      value: "\u653E\u7F6E\u5E76\u65CB\u8F6C\u7075\u5149\uFF0C\u9009\u62E9\u653E\u7535\u7684\u8D77\u70B9\u3002\n\u8BA9\u4FE1\u53F7\u6CBF\u5149\u4E1D\u4F20\u64AD\uFF0C\u5728\u8FDE\u9501\u4E2D\u521B\u9020\n\u8D85\u51FA\u9884\u671F\u7684\u56DE\u54CD\u3002"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SparkIntroTitle2
      value: "<size=18><color=#82AAB9>02 / 03</color></size>\n\u628A\u8FDE\u63A5\uFF0C\u7EC7\u6210\u4F60\u7684\u4E00\u751F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SparkIntroDescription2
      value: "\u4ECE\u5A74\u513F\u5230\u8001\u5E74\uFF0C\u7A7F\u8D8A\u516D\u4E2A\u4EBA\u751F\u9636\u6BB5\u3002\n\u5728\u4E0D\u65AD\u53D8\u5316\u7684\u5927\u8111\u4E2D\uFF0C\u8C03\u6574\u7F51\u7EDC\uFF0C\n\u5EA6\u8FC7\u5C5E\u4E8E\u4F60\u7684\u4EBA\u751F\u5173\u53E3\u3002"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SparkIntroTitle3
      value: "<size=18><color=#82AAB9>03 / 03</color></size>\n\u8BA9\u4E60\u60EF\uFF0C\u7559\u4E0B\u5F62\u72B6"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SparkIntroDescription3
      value: "\u5171\u540C\u95EA\u8000\u7684\u7075\u5149\uFF0C\u9010\u6E10\u51DD\u6210\u4E60\u60EF\u3002\n\u7528\u8BB0\u5FC6\u4E0E\u7269\u4EF6\u6539\u53D8\u8FDE\u63A5\uFF0C\u8BA9\u7B80\u5355\n\u89C4\u5219\u6D8C\u73B0\u51FA\u72EC\u5C5E\u4E8E\u4F60\u7684\u6784\u7B51\u3002"
