  - table: {fileID: 11400000, guid: 66868c0254b8442c399bf741211329a8, type: 2}
    tableContent:
    - key: SampleNote1Title
      value: "\u793A\u4F8B\u7B14\u8BB0"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote1Content
      value: "\u8FD9\u662F\u4E00\u7BC7\u7531 'Notepad Manager' \u7EC4\u4EF6\u521B\u5EFA\u7684\u793A\u4F8B\u7B14\u8BB0\u3002\u4F60\u4E5F\u53EF\u4EE5\u4F7F\u7528\u8BE5\u7BA1\u7406\u5668\u6DFB\u52A0\u65B0\u7684\u9884\u8BBE\u7B14\u8BB0\uFF01\n\n\u4F60\u8FD8\u53EF\u4EE5\u7F16\u8F91\u8FD9\u7BC7\u7B14\u8BB0\u53CA\u5176\u6807\u9898\u3002\u70B9\u51FB\u76F8\u5E94\u5185\u5BB9\u5373\u53EF\u5F00\u59CB\u4FEE\u6539\uFF01"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote2Title
      value: "\u53E6\u4E00\u7BC7\u7B14\u8BB0"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote2Content
      value: "\u4E2D\u56FD\u957F\u57CE\u662F\u4E16\u754C\u4E0A\u6700\u957F\u7684\u4EBA\u5DE5\u5EFA\u7B51\uFF0C\u5168\u957F\u7EA6
        21,196 \u516C\u91CC\uFF0813,171 \u82F1\u91CC\uFF09\u3002\u5B83\u5386\u7ECF\u591A\u4E2A\u4E16\u7EAA\u4FEE\u5EFA\uFF0C\u4ECE\u516C\u5143\u524D
        7 \u4E16\u7EAA\u5F00\u59CB\uFF0C\u4E00\u76F4\u5EF6\u7EED\u81F3\u516C\u5143
        17 \u4E16\u7EAA\u3002\u957F\u57CE\u662F\u4E00\u9879\u9632\u5FA1\u5DE5\u4E8B\uFF0C\u7528\u4E8E\u4FDD\u62A4\u4E2D\u56FD\u5317\u90E8\u8FB9\u5883\u514D\u906D\u5165\u4FB5\u548C\u88AD\u6270\u3002"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
