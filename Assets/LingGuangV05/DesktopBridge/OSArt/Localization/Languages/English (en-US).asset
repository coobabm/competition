  - table: {fileID: 11400000, guid: 5be61a8f2561b1b459eeba0252755c94, type: 2}
    tableContent:
    - key: TicTacToeDescription
      value: "Two players take turns marking a three-by-three grid with X and O. Whoever lines up three of their marks first wins."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: 3DTestDescription
      value: "A small demo that shows live 3D camera output inside the game window."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: EmptyGameDescription
      value: "A blank placeholder game that only demonstrates what a game window looks like."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: f6e6b4aaa6f2f004e915a560d310d6a5, type: 2}
    tableContent:
    - key: SampleMail1Subject
      value: "Hello from your inbox"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail1Content
      value: "This is a placeholder message built from a mail item. Mail items can carry attachments and any custom text.\n\nUse it to see how messages are laid out."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail2Subject
      value: "Meeting notes"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail2Content
      value: "Another placeholder message that shows up in the inbox list."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail3Subject
      value: "Sent mail example"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail3Content
      value: "A placeholder message that is stored in the 'Sent' folder."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail4Subject
      value: "Spam example"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleMail4Content
      value: "A placeholder message that is stored in the 'Spam' folder."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: c426ec06101062a4dbc9ef60778cd378, type: 2}
    tableContent:
    - key: ExampleChat_1
      value: "Hey, are you around?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_2
      value: "Yep, what's up with you?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_3
      value: "Not much. Did you finish the level designs yet?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_4
      value: "Almost. The deadline is brutal, so I had to trim a few ideas."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_5
      value: "And don't get me started on the bugs..."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_6
      value: "Crunch weeks wear me out. Hopefully this one ends soon."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_7
      value: "Same here."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_8
      value: "Did you hear the release got pushed back?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_9
      value: "No, I only just saw it online."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_10
      value: "Look at that face!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat_11
      value: "Aww, such a good boy!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_1
      value: "Erin!!! Long time no see, how have you been?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_2
      value: "Same old, working a lot. Pretty stressed lately. You?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_3
      value: "I quit my job, actually. Honestly I feel so much better."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_4
      value: "If you're happy, that's what counts!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_5
      value: "By the way, I lost your number and couldn't reach you for ages... sorry!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_6
      value: "Well, you have it now ;)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_7
      value: "So... want to get coffee sometime?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_8
      value: "It'd be nice to catch up properly ;)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_9
      value: "Sure, why not."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_10
      value: "Great! Tomorrow around 5 PM then?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_11
      value: "Perfect, see you then!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat2_12
      value: "Doing okay, and you?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleChat3_1
      value: "Congratulations! You have been picked to receive a prize worth $1,000,000. Reply to this message to claim it. It is completely genuine and definitely not a scam."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleDynamicMessage_1
      value: "You can type \"What's up?\" to get a reply."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleDynamicMessage_2
      value: "All good here, hope you're fine too!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleDynamicMessage_3
      value: "What's wrong?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleStoryTeller_1
      value: "To build a scripted back-and-forth, switch on the <b>StoryTeller</b> feature."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleStoryTeller_2
      value: "StoryTeller items can branch the conversation depending on which reply the player picks."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleStoryTeller_3
      value: "Use <b>'Call After'</b> to chain another item by its ID."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleStoryTeller_4
      value: "From your own code you can start an item with <b>MessagingManager.CreateStoryTeller(\"Chat ID\", \"StoryTeller ID\");</b>."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ExampleStoryTeller_5
      value: "Want to see it in action? Type <b>SEQ_0</b>. While 'Debug StoryTeller' is on, typing an item's ID plays it."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_1
      value: "Hey, how's it going?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R1B
      value: "Pretty bad"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R1C
      value: "Honestly, I've been feeling awful lately..."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R1F
      value: "Oh no, what happened?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R2B
      value: "Okay"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R2C
      value: "Not bad, and you?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R2F
      value: "Same here."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R3B
      value: "Great"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R3C
      value: "Pretty great, how about you?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ0_R3F
      value: "Then we're both doing well!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_1
      value: "It's just..."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R1B
      value: "I'm tired"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R1C
      value: "I don't know, I'm just worn out"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R1F
      value: "Since when?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R2B
      value: "Stomach ache"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R2C
      value: "My stomach really hurts"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R2F
      value: "You should see a doctor soon."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R3B
      value: "Can't sleep"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R3C
      value: "I can't sleep these days, no idea why"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1_R3F
      value: "I hope it's nothing serious!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_1
      value: "We should meet up sometime"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R1B
      value: "Sure"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R1C
      value: "Sure, sounds good :)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R1F
      value: "Awesome! Tell me when you're free :)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R2B
      value: "I'm busy"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R2C
      value: "Probably not, I'm swamped these days :/"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R2F
      value: "Oh well. Maybe another time."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R3B
      value: "No thanks"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R3C
      value: "No thanks, I'll pass on that."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ2_R3F
      value: "Ouch :'/"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_1
      value: "So, shall we catch up?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R1B
      value: "Sure"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R1C
      value: "Sure, why not :)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R1F
      value: "Great! Let me know when you have time :)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R2B
      value: "I'm busy"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R2C
      value: "I don't think I can, I've got a lot going on right now :/"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R2F
      value: "That's a shame. Let's try again later."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R3B
      value: "No thanks"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R3C
      value: "No thanks, I'd rather not."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ3_R3F
      value: "That stings :'/"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_1
      value: "Take care, and drink some water."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_R1B
      value: "Will do"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_R1C
      value: "Yeah, I will"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_R2B
      value: "Nope"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_R2C
      value: "Nope, I don't really like water"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SEQ1-1_R2F
      value: "Why not? Water is essential for your health."
      audioValue: {fileID: 0}
