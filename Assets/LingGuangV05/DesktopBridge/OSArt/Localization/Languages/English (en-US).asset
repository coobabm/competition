  - table: {fileID: 11400000, guid: 77e4b89821ef6914c86f04674a1d6b5b, type: 2}
    tableContent:
    - key: SampleNote1Title
      value: "First note"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote1Content
      value: "This note was made by the notepad manager. The manager can also add more ready-made notes.\n\nYou can edit this text and its title as well. Click on either one and start typing."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote2Title
      value: "Did you know?"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SampleNote2Content
      value: "The Pacific Ocean covers about a third of the Earth's surface, which is more than all of the continents put together. It also holds the deepest known spot in the sea, the Mariana Trench, at nearly eleven kilometers below the surface."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
