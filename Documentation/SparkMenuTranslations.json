  {
    "key": "EnableHintsDesc",
    "en": "First timer? Want to learn some new stuff while playing? If so, you can enable this.\n\n*This is a non-functional placeholder.",
    "zh": "开启后可显示操作提示。\n\n*此项为模板占位，尚无实际功能。"
  },
  {
    "key": "EnableSubtitlesDesc",
    "en": "See what people saying on the screen.\n\n*This is a non-functional placeholder.",
    "zh": "在屏幕上显示对话字幕。\n\n*此项为模板占位，尚无实际功能。"
  },
  {
    "key": "LanguageDesc",
    "en": "Switch the interface language instantly. Your choice is saved automatically.",
    "zh": "选择界面语言，切换立即生效，并自动保存选择。"
  },
  {
    "key": "UIScaleDesc",
    "en": "Too big? Too small? That's what she said? Well, you can manage UI size here.",
    "zh": "调整界面大小，让文字与按钮更易阅读。"
  },
  {
    "key": "SubtitleScaleDesc",
    "en": "Too big? Too small? That's what she said? Well, you can manage subtitle size here.\n\n*This is a non-functional placeholder.",
    "zh": "调整字幕大小。\n\n*此项为模板占位，尚无实际功能。"
  },
  {
    "key": "MasterVolumeDesc",
    "en": "If you want to decrease or increase the general volume of the game, you can play with this slider.",
    "zh": "调整游戏的整体音量。"
  },
  {
    "key": "MusicVolumeDesc",
    "en": "If you want to decrease or increase the music volume of the game, you can play with this slider.",
    "zh": "调整背景音乐音量。"
  },
  {
    "key": "SFXVolumeDesc",
    "en": "If you want to decrease or increase the effect volume of the game, you can play with this slider.",
    "zh": "调整游戏音效音量。"
  },
  {
    "key": "UIVolumeDesc",
    "en": "If you want to decrease or increase the UI of the game, you can play with this slider.",
    "zh": "调整按钮等界面音效的音量。"
  },
  {
    "key": "ResolutionDesc",
    "en": "Higher resolution screens are capable of producing sharper, clearer, more detailed images. You can choose any resolution you desire.",
    "zh": "选择画面分辨率。较高分辨率可呈现更清晰的细节。"
  },
  {
    "key": "SettingsDesc",
    "en": "Tweak some options and make your gameplay experience even better! You can change between categories using the buttons on the top.",
    "zh": "调整选项，打造适合自己的体验。\n使用顶部按钮切换设置分类。"
  },
  {
    "key": "VSyncLabel",
    "en": "VSync",
    "zh": "垂直同步"
  },
  {
    "key": "VSyncDesc",
    "en": "VSync is the graphics technology responsible for synchronizing the frame rate of a game to the refresh rate of a monitor. This synchronization delivers smooth, uninterrupted gameplay for graphics-heavy 3D games.",
    "zh": "将游戏帧率与显示器刷新率同步，减少画面撕裂。"
  },
  {
    "key": "FrameRateLabel",
    "en": "Frame Rate",
    "zh": "帧率上限"
  },
  {
    "key": "FrameRateDesc",
    "en": "Limit the frame rate. It is recommended to match this option with the refresh rate of your monitor. Note that this option has no effect when VSync is enabled.",
    "zh": "限制游戏帧率，建议与显示器刷新率一致。开启垂直同步时，此设置不生效。"
  },
